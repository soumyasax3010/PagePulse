# Application environment: development, test, or production.
NODE_ENV=development

# Bind to all interfaces by default so container and PaaS routing works.
HOST=0.0.0.0
PORT=3000

# Successful audit cache lifetime, in seconds.
CACHE_TTL_SECONDS=300

# Per-client-IP fixed-window rate limit.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
